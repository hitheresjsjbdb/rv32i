# =========================
# 基本配置
# =========================
CXX      := g++
CXXFLAGS := -std=c++17 -Wall -Wextra -O2 -Iinclude

TARGET   := semu

# =========================
# 目录
# =========================
SRC_DIR := src
OBJ_DIR := build

# =========================
# 自动查找源文件
# =========================
SRCS := $(shell find $(SRC_DIR) -name "*.cpp")
OBJS := $(patsubst $(SRC_DIR)/%.cpp,$(OBJ_DIR)/%.o,$(SRCS))
DEPS := $(OBJS:.o=.d)

# =========================
# 默认目标
# =========================
.PHONY: all
all: $(TARGET)

# =========================
# 链接
# =========================
$(TARGET): $(OBJS)
	$(CXX) $^ -o $@

# =========================
# 编译规则（带自动依赖）
# =========================
$(OBJ_DIR)/%.o: $(SRC_DIR)/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -MMD -MP -c $< -o $@

# =========================
# 包含依赖文件
# =========================
-include $(DEPS)

# =========================
# 清理
# =========================
.PHONY: clean
clean:
	rm -rf $(OBJ_DIR) $(TARGET)