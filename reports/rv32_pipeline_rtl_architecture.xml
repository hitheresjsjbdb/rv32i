  <hazardManagement source="cpu/rtl/rtl/ControlUnit.v:120-146,390-405">
    <bubbleCondition>
      <description>IF bubble is asserted for load-use style conflicts unless a branch redirect is already active.</description>
      <expression><![CDATA[
(branch != 1'b1) &&
(((rs1 == EX_rd || rs2 == EX_rd) && EX_RFWrite == 1'b1 && EX_rd != 5'b0 && EX_WDSel == `WDSel_FromMEM) ||
 (ID_WDSel == `WDSel_FromMEM && ID_RFWrite == 1'b1) ||
 ((rs1 == MEM_rd || rs2 == MEM_rd) && DMReadStall == 1'b1))
      ]]></expression>
    </bubbleCondition>
    <forwarding>
      <path name="WB to ID rs1" predicate="(ID_rs1_out == WB_rd) &amp;&amp; WB_RFWrite &amp;&amp; (WB_rd != 0)"/>
      <path name="WB to ID rs2" predicate="(ID_rs2_out == WB_rd) &amp;&amp; WB_RFWrite &amp;&amp; (WB_rd != 0)"/>
      <path name="MEM to ID rs1" predicate="(ID_rs1_out == MEM_rd) &amp;&amp; MEM_RFWrite_out &amp;&amp; (MEM_WDSel_out == WDSel_FromALU) &amp;&amp; (MEM_rd != 0)"/>
      <path name="MEM to ID rs2" predicate="(ID_rs2_out == MEM_rd) &amp;&amp; MEM_RFWrite_out &amp;&amp; (MEM_WDSel_out == WDSel_FromALU) &amp;&amp; (MEM_rd != 0)"/>
      <path name="EX to ID rs1" predicate="(ID_rs1_out == EX_rd_out) &amp;&amp; EX_RFWrite &amp;&amp; (EX_rd_out != 0) &amp;&amp; (EX_WDSel == WDSel_FromALU)"/>
      <path name="EX to ID rs2" predicate="(ID_rs2_out == EX_rd_out) &amp;&amp; EX_RFWrite &amp;&amp; (EX_rd_out != 0) &amp;&amp; (EX_WDSel == WDSel_FromALU)"/>
      <note>EX-stage operand forwarding outputs EX_RD1_out and EX_RD2_out are declared but not consumed by the current top module, and the related ControlUnit code is commented out.</note>
    </forwarding>
    <loadStallShadow>
      <predicate><![CDATA[(MEM_RFWrite_out == 1'b1) && (MEM_WDSel_out == `WDSel_FromMEM)]]></predicate>
      <behavior>When true, MEMSTALL registers preserve rd, WDSel, RFWrite, done, and dnpc so the writeback mux and WB bookkeeping can complete in a following cycle.</behavior>
    </loadStallShadow>
  </hazardManagement>

  <controlFlow>
    <branchAndJumpPath source="cpu/rtl/rtl/ControlUnit.v:349-379,cpu/rtl/rtl/PC.v:26-29,cpu/rtl/rtl/NPC.v:31-47">
      <compareSource>ID_zero = (ID_RD1_out == ID_RD2_out)</compareSource>
      <idStageIntent>
        <rule instruction="beq">ID_NPCOp = NPC_Offset12 when ID_zero is true, else NPC_PC</rule>
        <rule instruction="bne">ID_NPCOp = NPC_PC when ID_zero is true, else NPC_Offset12</rule>
        <rule instruction="jal">ID_NPCOp = NPC_Offset20</rule>
        <rule instruction="jalr">ID_NPCOp = NPC_rs</rule>
      </idStageIntent>
      <pipelineAction>branch and EX_NPCOp are flopped before they affect PC redirection.</pipelineAction>
      <pcRedirectBehavior>
        <item>PC_NPC = EX_branch ? (NPC_NPC + 4) : (IF_bubble ? IF_PCA4 : NPC_NPC)</item>
        <item>IM_PC = EX_branch ? NPC_NPC : (IF_bubble ? IF_PC : PC)</item>
        <item>NPC_PC = EX_branch ? EX_PC : PC</item>
      </pcRedirectBehavior>
      <jalrDetail>NPC refines the jalr target to (rs_aligned + Imm12Ext) &amp; 32'hffff_fffe.</jalrDetail>
    </branchAndJumpPath>
    <writebackPath source="cpu/rtl/rtl/MUX_3to1_LMD.v:14-24,cpu/rtl/rtl/RF.v:18-35">
      <item>ALU-producing instructions use WDSel_FromALU.</item>
      <item>lw uses WDSel_FromMEM and may pass through MEMSTALL shadow bookkeeping.</item>
      <item>jal and jalr use WDSel_FromPC so that PC plus 4 is written to rd.</item>
    </writebackPath>
  </controlFlow>

